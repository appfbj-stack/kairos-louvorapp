# ============================================================
# Kairos Louvor - Variáveis de ambiente (exemplo)
# Copie para .env e ajuste para seu ambiente
# ============================================================

# URL pública do app (tenant)
APP_URL="https://louvorapp.fbautomacao.space"

# URL pública do super admin
ADMIN_URL="https://admin.louvorapp.fbautomacao.space"

# Porta interna do servidor (sempre 3000 no container)
PORT=3000

# Ambiente (development | production)
NODE_ENV=production

# ============================================================
# JWT Secret — gerar um novo e seguro em produção!
# Exemplo: openssl rand -hex 32
# ============================================================
JWT_SECRET="kairos-louvor-jwt-secret-2026-rotate-em-prod-A8nM3kP9xR2wT"

# ============================================================
# Database (PostgreSQL — kairos-shared-pg)
# Em produção via Dokploy, usar DATABASE_URL com senha forte
# ============================================================
DATABASE_URL="postgresql://kairos_louvorapp_user:SUA_SENHA@kairos-shared-pg:5432/kairos_louvorapp_db"

# ============================================================
# Google Gemini API (feature de IA — mantido da V1)
# https://aistudio.google.com/app/apikey
# ============================================================
API_KEY="sua_chave_gemini_aqui"
